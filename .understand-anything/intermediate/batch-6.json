    },
    {
      "id": "file:MailerServer/email.js",
      "type": "file",
      "name": "email.js",
      "filePath": "MailerServer/email.js",
      "summary": "基于 nodemailer 封装的 SMTP 邮件发送模块，使用 163 邮箱作为发送方，提供 SendMail 异步函数和 SMTP 连接测试功能。模块加载时自动验证 SMTP 连接。",
      "tags": ["utility", "email-notification", "service"],
      "complexity": "simple",
      "languageNotes": "使用 Promise 封装 nodemailer 的回调式 sendMail API，模块加载时调用 testConnection() 验证 SMTP 连通性。"
    },
    {
      "id": "function:MailerServer/email.js:SendMail",
      "type": "function",
      "name": "SendMail",
      "filePath": "MailerServer/email.js",
      "lineRange": [29, 42],
      "summary": "发送邮件的异步函数，接收邮件选项参数，返回 Promise，成功时 resolve 响应信息，失败时 reject 错误。",
      "tags": ["email-notification", "async", "utility"],
      "complexity": "simple"
    },
    {
      "id": "file:MailerServer/proto.js",
      "type": "file",
      "name": "proto.js",
      "filePath": "MailerServer/proto.js",
      "summary": "gRPC Protobuf 加载模块，同步加载同目录下的 message.proto 并导出 protoDescriptor，供服务端注册 RPC 处理器使用。",
      "tags": ["protobuf", "grpc", "configuration"],
      "complexity": "simple"
    },
    {
